<ForceField version="0.0.1" name="HOOMD-DPD">
    <FFMetaData combiningRule="lorentz">
        <Units energy="kJ/mol" distance="nm" mass="amu" time="s" charge="coulomb"/>
    </FFMetaData>
    <AtomTypes>
       <AtomType name="_A" element="_A" atomclass="_A" mass="1.0" charge="0.0" definition="_A" description="CG Bead"/>
       <AtomType name="_B" element="_B" atomclass="_B" mass="1.0" charge="0.0" definition="_B" description="CG Bead"/>
        <AtomType name="_C" element="_C" atomclass="_C" mass="1.0" charge="0.0" definition="_C" description="CG Bead"/>
    </AtomTypes>
    <BondTypes expression="0.5 * k * (r-r_eq)**2">
        <ParametersUnitDef parameter="r_eq" unit="nm"/>
        <ParametersUnitDef parameter="k" unit="kJ/mol/(nm**2)"/>
        <BondType name="HarmonicBondPotential" type1="_C" type2="_A">
            <Parameters>
                <Parameter name="r_eq" value="1.0"/>
                <Parameter name="k" value="250000"/>
            </Parameters>
        </BondType>
        <BondType name="HarmonicBondPotential" type1="_A" type2="_A">
            <Parameters>
                <Parameter name="r_eq" value="1.0"/>
                <Parameter name="k" value="250000"/>
            </Parameters>
        </BondType>
        <BondType name="HarmonicBondPotential" type1="_A" type2="_B">
            <Parameters>
                <Parameter name="r_eq" value="1.0"/>
                <Parameter name="k" value="250000"/>
            </Parameters>
        </BondType>
    </BondTypes>
  <PairPotentialTypes expression="A * (1-(r/r_cut)) - γ">
    <ParametersUnitDef parameter="A" unit="N"/>
    <ParametersUnitDef parameter="r_cut" unit="nm"/>
    <ParametersUnitDef parameter="γ" unit="amu/s/nm"/>
    <PairPotentialType name="HOOMDDPDForce" type1="_A" type2="_A">
        <Parameters>
            <Parameter name="A" value="250000"/>
	        <Parameter name="r_cut" value="1.01"/>
	        <Parameter name="γ" value="1500"/>
        </Parameters>
    </PairPotentialType>
    <PairPotentialType name="HOOMDDPDForce" type1="_A" type2="_B">
        <Parameters>
            <Parameter name="A" value="250000.0"/>
	        <Parameter name="r_cut" value="1.01"/>
	        <Parameter name="γ" value="1500"/>
        </Parameters>
    </PairPotentialType>
    <PairPotentialType name="HOOMDDPDForce" type1="_B" type2="_B">
        <Parameters>
            <Parameter name="A" value="250000.0"/>
	        <Parameter name="r_cut" value="1.01"/>
	        <Parameter name="γ" value="1500"/>
        </Parameters>
    </PairPotentialType>
    <PairPotentialType name="HOOMDDPDForce" type1="_B" type2="_C">
        <Parameters>
            <Parameter name="A" value="250000.0"/>
	        <Parameter name="r_cut" value="1.01"/>
	        <Parameter name="γ" value="1500"/>
        </Parameters>
    </PairPotentialType>
    <PairPotentialType name="HOOMDDPDForce" type1="_C" type2="_C">
        <Parameters>
            <Parameter name="A" value="250000.0"/>
	        <Parameter name="r_cut" value="1.01"/>
	        <Parameter name="γ" value="1500"/>
        </Parameters>
    </PairPotentialType>
    <PairPotentialType name="HOOMDDPDForce" type1="_A" type2="_C">
        <Parameters>
            <Parameter name="A" value="250000.0"/>
	        <Parameter name="r_cut" value="1.01"/>
	        <Parameter name="γ" value="1500"/>
        </Parameters>
    </PairPotentialType>
  </PairPotentialTypes>
</ForceField>
